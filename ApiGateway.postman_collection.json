{
  "info": {
    "name": "API Gateway Test",
    "_postman_id": "api-gateway-local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url",   "value": "http://localhost:8080" },
    { "key": "token",         "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "fake_token",    "value": "header.payload.invalidsignature" }
  ],
  "item": [
    {
      "name": "1. 로그인 (토큰 자동 저장)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "if (res.access_token) {",
              "    pm.environment.set('token', res.access_token);",
              "    console.log('✅ access_token 저장 완료');",
              "} else {",
              "    console.log('❌ access_token 없음:', JSON.stringify(res));",
              "}",
              "if (res.refresh_token) {",
              "    pm.environment.set('refresh_token', res.refresh_token);",
              "    console.log('✅ refresh_token 저장 완료');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"test\",\n  \"password\": \"test\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/auth/login",
          "host": ["{{gateway_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "2. test-service 호출 (토큰 자동 첨부)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/test-dynamic/echo",
          "host": ["{{gateway_url}}"],
          "path": ["test-dynamic", "echo"]
        }
      }
    },
    {
      "name": "2-1. 토큰 갱신 (새 토큰 자동 저장)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "if (res.access_token) {",
              "    pm.environment.set('token', res.access_token);",
              "    console.log('✅ access_token 갱신 완료');",
              "}",
              "if (res.refresh_token) {",
              "    pm.environment.set('refresh_token', res.refresh_token);",
              "    console.log('✅ refresh_token 갱신 완료');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/auth/refresh",
          "host": ["{{gateway_url}}"],
          "path": ["auth", "refresh"]
        }
      }
    },
    {
      "name": "3. 로그아웃 (토큰 삭제)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set('old_token', pm.environment.get('token'));",
              "pm.environment.set('token', '');",
              "pm.environment.set('refresh_token', '');",
              "console.log('✅ 토큰 삭제 완료 / old_token 백업 완료');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/auth/logout",
          "host": ["{{gateway_url}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "3-1. 로그아웃된 토큰 재사용 → 401 확인",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 Unauthorized (블랙리스트 즉시 반영)', () => pm.response.to.have.status(401));",
              "pm.test('에러 메시지 확인', () => {",
              "    var res = pm.response.json();",
              "    pm.expect(res.message).to.include('유효하지 않은 토큰');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{old_token}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/test-dynamic/echo",
          "host": ["{{gateway_url}}"],
          "path": ["test-dynamic", "echo"]
        }
      }
    },
    {
      "name": "4. 인증 실패 — 토큰 없이 호출 (401 확인)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('에러 메시지 확인', () => {",
              "    var res = pm.response.json();",
              "    pm.expect(res.message).to.include('인증 토큰이 없습니다');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/test-dynamic/echo",
          "host": ["{{gateway_url}}"],
          "path": ["test-dynamic", "echo"]
        }
      }
    },
    {
      "name": "5. 인증 실패 — 위조 토큰 (401 확인)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('에러 메시지 확인', () => {",
              "    var res = pm.response.json();",
              "    pm.expect(res.message).to.include('유효하지 않은 토큰');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{fake_token}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/test-dynamic/echo",
          "host": ["{{gateway_url}}"],
          "path": ["test-dynamic", "echo"]
        }
      }
    },
    {
      "name": "5-1. 권한 없는 경로 접근 → 403 확인 (role-auth.rules 설정 필요)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403 Forbidden (권한 없음)', () => pm.response.to.have.status(403));",
              "pm.test('에러 메시지 확인', () => {",
              "    var res = pm.response.json();",
              "    pm.expect(res.message).to.include('접근 권한이 없습니다');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/test-dynamic/echo",
          "host": ["{{gateway_url}}"],
          "path": ["test-dynamic", "echo"]
        }
      }
    },
    {
      "name": "6. 헬스체크 (게이트웨이 상태 확인)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status UP', () => {",
              "    var res = pm.response.json();",
              "    pm.expect(res.status).to.equal('UP');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/actuator/health",
          "host": ["{{gateway_url}}"],
          "path": ["actuator", "health"]
        }
      }
    },
    {
      "name": "관리 API — 서비스·인스턴스·라우팅 등록",
      "item": [
        {
          "name": "서비스 등록",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"my-service\",\n  \"serviceName\": \"서비스 이름\",\n  \"description\": \"설명 (선택)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/console/api/services",
              "host": ["{{gateway_url}}"],
              "path": ["console", "api", "services"]
            }
          }
        },
        {
          "name": "인스턴스 등록",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"host\": \"192.168.1.x\",\n  \"port\": 8080,\n  \"protocol\": \"http\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/console/api/services/my-service/instances",
              "host": ["{{gateway_url}}"],
              "path": ["console", "api", "services", "my-service", "instances"]
            }
          }
        },
        {
          "name": "라우팅 등록 (id·apiPath 필드 사용 — routeId·path 아님)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"my-route\",\n  \"apiPath\": \"/my/**\",\n  \"method\": \"ALL\",\n  \"priority\": 10,\n  \"targetServiceId\": \"my-service\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/console/api/routes",
              "host": ["{{gateway_url}}"],
              "path": ["console", "api", "routes"]
            }
          }
        },
        {
          "name": "라우팅 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/console/api/routes",
              "host": ["{{gateway_url}}"],
              "path": ["console", "api", "routes"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Rate Limit 테스트 — 429 확인 (Collection Runner로 실행)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var status = pm.response.code;",
              "if (status === 429) {",
              "    pm.test('Rate Limit 초과 확인 (429)', () => pm.response.to.have.status(429));",
              "    console.log('✅ Rate Limit 동작 확인');",
              "} else {",
              "    console.log('현재 요청 횟수: ' + pm.info.iteration);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/test-dynamic/echo",
          "host": ["{{gateway_url}}"],
          "path": ["test-dynamic", "echo"]
        }
      }
    }
  ]
}
